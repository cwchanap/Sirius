# Godot 4+ specific ignores
.godot/
/android/
*.uid
*.import
frames/

assets/**/original
addons/*
!addons/sirius_floor_tools/
TestResults/
gdunit4_testadapter_v5/

# Local test settings (not checked into git)
test.runsettings.local
*.local.runsettings

# Claude / Devin local settings
.claude/settings.local.json
.mcp.json
.devin/

# Orphaned temp files from atomic-write helpers (FloorSceneWriter,
# AtomicFileWriter, UidPreserver) and Godot's UID/import pipeline.
# These appear if a process is killed mid-save; safe to ignore.
*.tmp.*
*.uidtmp

# Local git worktrees
.worktrees/

# Local brainstorming visual companion artifacts
.superpowers/
tests/tools/__pycache__/

# Floor layout JSON: tracked as the C# generation baseline (regenerate via
# `godot --headless --script tools/generate_floor.gd -- --floor <0|1|2|3>`)
# The deprecated Python generators in tools/floor*_maze_generator.py are frozen
# historical references; the C# FloorGenerationService is the source of truth.

